<sdf version="1.9">
  <world name="bunker_test">
    <physics name="default" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system">
      <engine filename="gz-physics-dartsim-plugin" />
    </plugin>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="bunker_mini">
      <pose>0 0 0.28 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>36.9538420525263</mass>
          <inertia>
            <ixx>0.42527713228782354</ixx>
            <iyy>0.8391601632761181</iyy>
            <izz>1.125860387866968</izz>
          </inertia>
          <pose>0 0 -0.07 0 0 0</pose>
        </inertial>
        <collision name="chassis">
          <pose>0 0 -0.07 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 0.34 0.15</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="manufacturer_mini_mesh">
          <geometry>
            <mesh>
              <uri>file:///ros-data/assets/bunker_mini/base_link.STL</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <link name="left_track">
        <pose>0 0.226 -0.184197 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.007490666666666666</ixx>
            <iyy>0.07366666666666667</iyy>
            <izz>0.07035733333333334</izz>
          </inertia>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name="track_contact">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.64 0.112 0.18</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
      <joint name="left_track_fixed" type="fixed">
        <parent>base_link</parent>
        <child>left_track</child>
      </joint>
      <plugin name="gz::sim::systems::TrackController" filename="gz-sim-track-controller-system">
        <link>left_track</link>
        <max_command_age>0.25</max_command_age>
        <min_velocity>-0.6</min_velocity>
        <max_velocity>0.6</max_velocity>
      </plugin>
      <link name="right_track">
        <pose>0 -0.226 -0.184197 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.007490666666666666</ixx>
            <iyy>0.07366666666666667</iyy>
            <izz>0.07035733333333334</izz>
          </inertia>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name="track_contact">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.64 0.112 0.18</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
      <joint name="right_track_fixed" type="fixed">
        <parent>base_link</parent>
        <child>right_track</child>
      </joint>
      <plugin name="gz::sim::systems::TrackController" filename="gz-sim-track-controller-system">
        <link>right_track</link>
        <max_command_age>0.25</max_command_age>
        <min_velocity>-0.6</min_velocity>
        <max_velocity>0.6</max_velocity>
      </plugin>
      <plugin name="gz::sim::systems::TrackedVehicle" filename="gz-sim-tracked-vehicle-system">
        <left_track>
          <link>left_track</link>
        </left_track>
        <right_track>
          <link>right_track</link>
        </right_track>
        <tracks_separation>0.452</tracks_separation>
        <steering_efficiency>0.624</steering_efficiency>
        <body_link>base_link</body_link>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <linear_velocity>
          <min_velocity>-0.35</min_velocity>
          <max_velocity>0.35</max_velocity>
        </linear_velocity>
        <angular_velocity>
          <min_velocity>-0.6</min_velocity>
          <max_velocity>0.6</max_velocity>
        </angular_velocity>
      </plugin>
      <plugin name="gz::sim::systems::OdometryPublisher" filename="gz-sim-odometry-publisher-system">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_topic>/model/bunker_mini/ground_truth/odometry</odom_topic>
        <tf_topic>/model/bunker_mini/ground_truth/tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </model>
  </world>
</sdf>